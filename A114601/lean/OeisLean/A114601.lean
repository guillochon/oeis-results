import Mathlib

/-!
# A114601: root bases of the lattices `D_k` and `A_k`

The formula for A114601 (see `attacks/A114601/proofs.md`) counts, for each irreducible root lattice,
the bases consisting of roots. This file formalizes the characterization of those bases used for
the two infinite families (Lemmas 2.1 and 3.3 of the proof), in the form of lattice equalities:

* **Type D** (`span_eq_D_iff`). A set `S` of *signed edges* on the coordinates `Fin k` (the edge
  `(a, b, s)` stands for the root `e a - s • e b`, i.e. `e_a - e_b` or `e_a + e_b`) generates the
  lattice `D_k = {x | ∑ x even}` iff every two coordinates are joined by a walk in `S` and some
  closed walk has sign product `-1` ("an unbalanced cycle").
* **Type A** (`span_eq_A_iff`). With all signs `+1`, `S` generates `A = {x | ∑ x = 0}` iff every two
  coordinates are joined by a walk (the graph is connected).

With `|S| = k` (resp. `|S| = rank`), generating the lattice is the same as being a basis, which
turns these into the counts of the proof: connected graphs with `k` edges on `k` vertices are
unicyclic, which gives the formula for `c_D`, and connected graphs with `k` edges on `k + 1`
vertices are spanning trees, which gives the formula for `c_A`.

Not formalized here: Witt's classification of root lattices, the orders of their automorphism
groups, the counting of unicyclic graphs and trees, and the computed `E_6, E_7, E_8` constants.
-/

open Finset

namespace A114601

variable {k : ℕ}

/-- A signed edge `(a, b, s)` on the coordinates `Fin k`, standing for the root `e a - s • e b`
(`s = 1`: `e_a - e_b`; `s = -1`: `e_a + e_b`). -/
structure SEdge (k : ℕ) where
  a : Fin k
  b : Fin k
  ne : a ≠ b
  s : ℤ
  hs : s = 1 ∨ s = -1

/-- The unit vector `e i`. -/
def ev (i : Fin k) : Fin k → ℤ := Pi.single i 1

/-- The root of a signed edge. -/
def vec (e : SEdge k) : Fin k → ℤ := ev e.a - e.s • ev e.b

/-- The lattice generated by the roots of `S`. -/
def L (S : Set (SEdge k)) : AddSubgroup (Fin k → ℤ) := AddSubgroup.closure (vec '' S)

/-- `D_k`: integer vectors with even coordinate sum. -/
def D (k : ℕ) : AddSubgroup (Fin k → ℤ) where
  carrier := {x | Even (∑ i, x i)}
  add_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq, Pi.add_apply, sum_add_distrib] at *
    exact hx.add hy
  zero_mem' := by simp
  neg_mem' {x} hx := by
    simp only [Set.mem_ofPred_eq, Pi.neg_apply, sum_neg_distrib] at *
    exact hx.neg

/-- `A`: integer vectors with coordinate sum `0` (the root lattice `A_(k-1)` in `ℤ^k`). -/
def A (k : ℕ) : AddSubgroup (Fin k → ℤ) where
  carrier := {x | ∑ i, x i = 0}
  add_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq, Pi.add_apply, sum_add_distrib] at *
    rw [hx, hy, add_zero]
  zero_mem' := by simp
  neg_mem' {x} hx := by
    simp only [Set.mem_ofPred_eq, Pi.neg_apply, sum_neg_distrib] at *
    rw [hx, neg_zero]

/-- Signed walks in `S`: `Walk S u w t` says there is a walk from `u` to `w` using edges of `S` (in
either direction) whose signs multiply to `t`. -/
inductive Walk (S : Set (SEdge k)) : Fin k → Fin k → ℤ → Prop
  | nil (u : Fin k) : Walk S u u 1
  | fwd {u w : Fin k} {t : ℤ} (e : SEdge k) (he : e ∈ S) (p : Walk S u w t) (h : e.a = w) :
      Walk S u e.b (t * e.s)
  | bwd {u w : Fin k} {t : ℤ} (e : SEdge k) (he : e ∈ S) (p : Walk S u w t) (h : e.b = w) :
      Walk S u e.a (t * e.s)

section basic

variable {S : Set (SEdge k)}

lemma SEdge.s_mul_s (e : SEdge k) : e.s * e.s = 1 := by
  rcases e.hs with h | h <;> simp [h]

lemma Walk.sign {u w : Fin k} {t : ℤ} (p : Walk S u w t) : t = 1 ∨ t = -1 := by
  induction p with
  | nil => left; rfl
  | fwd e _ _ _ ih | bwd e _ _ _ ih =>
    rcases ih with h | h <;> rcases e.hs with h' | h' <;> simp [h, h']

lemma Walk.trans {u w x : Fin k} {t t' : ℤ} (p : Walk S u w t) (q : Walk S w x t') :
    Walk S u x (t * t') := by
  induction q with
  | nil => simpa using p
  | fwd e he _ h ih => simpa [mul_assoc] using Walk.fwd e he ih h
  | bwd e he _ h ih => simpa [mul_assoc] using Walk.bwd e he ih h

lemma Walk.symm {u w : Fin k} {t : ℤ} (p : Walk S u w t) : Walk S w u t := by
  induction p with
  | nil => exact Walk.nil _
  | fwd e he _ h ih =>
    have step : Walk S e.b e.a (1 * e.s) := Walk.bwd e he (Walk.nil _) rfl
    rw [h] at step
    simpa [mul_comm] using step.trans ih
  | bwd e he _ h ih =>
    have step : Walk S e.a e.b (1 * e.s) := Walk.fwd e he (Walk.nil _) rfl
    rw [h] at step
    simpa [mul_comm] using step.trans ih

lemma vec_mem {e : SEdge k} (he : e ∈ S) : vec e ∈ L S :=
  AddSubgroup.subset_closure ⟨e, he, rfl⟩

/-- The key identity: a walk from `u` to `w` with sign `t` puts `e u - t • e w` in the lattice. -/
lemma Walk.mem_L {u w : Fin k} {t : ℤ} (p : Walk S u w t) : ev u - t • ev w ∈ L S := by
  induction p with
  | nil => simp
  | @fwd w t e he _ h ih =>
    subst h
    have := add_mem ih (zsmul_mem (vec_mem he) t)
    convert this using 1
    simp only [vec, smul_sub, smul_smul]
    abel
  | @bwd w t e he _ h ih =>
    subst h
    have := add_mem ih (zsmul_mem (vec_mem he) (-(t * e.s)))
    convert this using 1
    have hss := e.s_mul_s
    simp only [vec, smul_sub, smul_smul]
    rw [show -(t * e.s) * e.s = -t by linear_combination (-t) * hss]
    simp only [neg_smul, sub_neg_eq_add]
    abel

lemma sum_ev (i : Fin k) : ∑ j, ev i j = 1 := by simp [ev]

lemma sum_smul_ev (x : Fin k → ℤ) : ∑ i, x i • ev i = x := by
  funext j
  simp [ev, Finset.sum_apply, Pi.single_apply]

end basic

/-! ## Type D -/

section typeD

variable {S : Set (SEdge k)}

lemma vec_mem_D (e : SEdge k) : vec e ∈ D k := by
  change Even (∑ i, (ev e.a - e.s • ev e.b) i)
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, sum_sub_distrib, ← mul_sum, sum_ev, mul_one]
  rcases e.hs with h | h <;> simp [h]

lemma L_le_D : L S ≤ D k :=
  (AddSubgroup.closure_le _).2 (by rintro _ ⟨e, -, rfl⟩; exact vec_mem_D e)

/-- Sufficiency: connected with an unbalanced closed walk implies the roots generate `D_k`. -/
lemma D_le_L (hconn : ∀ u w, ∃ t, Walk S u w t) (hub : ∃ u, Walk S u u (-1)) : D k ≤ L S := by
  obtain ⟨u, hu⟩ := hub
  have h2u : (2 : ℤ) • ev u ∈ L S := by
    have := hu.mem_L
    convert this using 1
    simp only [neg_smul, one_smul, sub_neg_eq_add, two_smul]
  -- e i - e u ∈ L for every i
  have hdiff : ∀ i, ev i - ev u ∈ L S := by
    intro i
    obtain ⟨t, p⟩ := hconn u i
    have hp := p.mem_L
    rcases p.sign with rfl | rfl
    · have := neg_mem hp
      convert this using 1
      simp
    · have := sub_mem hp h2u
      convert this using 1
      simp only [neg_smul, one_smul, sub_neg_eq_add, two_smul]
      abel
  intro x hx
  obtain ⟨m, hm⟩ : Even (∑ i, x i) := hx
  have hdecomp : x = ∑ i, x i • (ev i - ev u) + m • ((2 : ℤ) • ev u) := by
    simp only [smul_sub, sum_sub_distrib, sum_smul_ev, ← sum_smul, hm, smul_smul]
    rw [show m * 2 = m + m by ring]
    abel
  rw [hdecomp]
  exact add_mem (sum_mem fun i _ => zsmul_mem (hdiff i) _) (zsmul_mem h2u _)

/-- Necessity of connectivity: if some `w` cannot be reached from `u`, the parity of the coordinate
sum over the reachable set is an invariant of `L S` that `e u + e w ∈ D_k` violates. -/
lemma conn_of_eq (h : L S = D k) : ∀ u w, ∃ t, Walk S u w t := by
  classical
  by_contra hcon
  push Not at hcon
  obtain ⟨u, w, hw⟩ := hcon
  set V : Finset (Fin k) := univ.filter (fun v => ∃ t, Walk S u v t) with hV
  let φ : (Fin k → ℤ) → ℤ := fun x => ∑ i ∈ V, x i
  have hφ_ev : ∀ i, φ (ev i) = if i ∈ V then 1 else 0 := by
    intro i
    simp only [φ, ev, Finset.sum_pi_single']
  have hinv : ∀ y ∈ L S, Even (φ y) := by
    intro y hy
    induction hy using AddSubgroup.closure_induction with
    | mem y hy =>
      obtain ⟨e, he, rfl⟩ := hy
      have hab : e.a ∈ V ↔ e.b ∈ V := by
        simp only [hV, mem_filter, mem_univ, true_and]
        constructor
        · rintro ⟨t, p⟩; exact ⟨_, Walk.fwd e he p rfl⟩
        · rintro ⟨t, p⟩; exact ⟨_, Walk.bwd e he p rfl⟩
      have : φ (vec e) = φ (ev e.a) - e.s * φ (ev e.b) := by
        simp only [φ, vec, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, sum_sub_distrib, ← mul_sum]
      rw [this, hφ_ev, hφ_ev]
      by_cases ha : e.a ∈ V
      · rw [if_pos ha, if_pos (hab.1 ha)]
        rcases e.hs with hs | hs <;> simp [hs]
      · rw [if_neg ha, if_neg (fun hb => ha (hab.2 hb))]
        simp
    | zero => simp [φ]
    | add y z _ _ hy hz =>
      simp only [φ, Pi.add_apply, sum_add_distrib] at *
      exact hy.add hz
    | neg y _ hy =>
      simp only [φ, Pi.neg_apply, sum_neg_distrib] at *
      exact hy.neg
  have huV : u ∈ V := by
    simp only [hV, mem_filter, mem_univ, true_and]; exact ⟨1, Walk.nil u⟩
  have hwV : w ∉ V := by
    simp only [hV, mem_filter, mem_univ, true_and, not_exists]; exact hw
  have hmem : ev u + ev w ∈ D k := by
    change Even (∑ i, (ev u + ev w) i)
    simp [Pi.add_apply, sum_add_distrib, sum_ev]
  rw [← h] at hmem
  have := hinv _ hmem
  simp only [φ, Pi.add_apply, sum_add_distrib] at this
  have h1 : φ (ev u) = 1 := by rw [hφ_ev, if_pos huV]
  have h0 : φ (ev w) = 0 := by rw [hφ_ev, if_neg hwV]
  simp only [φ] at h1 h0
  rw [h1, h0] at this
  simp at this

/-- Necessity of an unbalanced closed walk: otherwise the walk signs from a base point give a
consistent sign `ε v` for each coordinate, and `x ↦ ∑ ε v * x v` vanishes on `L S` but not on
`2 • e u₀ ∈ D_k`. -/
lemma unbal_of_eq (hk : 0 < k) (h : L S = D k) : ∃ u, Walk S u u (-1) := by
  classical
  by_contra hno
  push Not at hno
  have hconn := conn_of_eq h
  let u₀ : Fin k := ⟨0, hk⟩
  choose ε hε using fun v => hconn u₀ v
  -- walk signs from u₀ are well defined
  have hwd : ∀ {v t t'}, Walk S u₀ v t → Walk S u₀ v t' → t = t' := by
    intro v t t' p q
    have c := p.trans q.symm
    rcases p.sign with rfl | rfl <;> rcases q.sign with rfl | rfl
    · rfl
    · exact absurd (by simpa using c) (hno u₀)
    · exact absurd (by simpa using c) (hno u₀)
    · rfl
  let f : (Fin k → ℤ) → ℤ := fun x => ∑ v, ε v * x v
  have hf_ev : ∀ i, f (ev i) = ε i := by
    intro i
    simp [f, ev, Pi.single_apply]
  have hker : ∀ y ∈ L S, f y = 0 := by
    intro y hy
    induction hy using AddSubgroup.closure_induction with
    | mem y hy =>
      obtain ⟨e, he, rfl⟩ := hy
      have hb : ε e.b = ε e.a * e.s := hwd (hε e.b) (Walk.fwd e he (hε e.a) rfl)
      have : f (vec e) = f (ev e.a) - e.s * f (ev e.b) := by
        simp only [f, vec, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, mul_sub, sum_sub_distrib]
        rw [mul_sum]
        congr 1
        refine sum_congr rfl fun v _ => by ring
      rw [this, hf_ev, hf_ev, hb]
      linear_combination (-(ε e.a)) * e.s_mul_s
    | zero => simp [f]
    | add y z _ _ hy hz =>
      simp only [f, Pi.add_apply, mul_add, sum_add_distrib] at *
      rw [hy, hz, add_zero]
    | neg y _ hy =>
      simp only [f, Pi.neg_apply, mul_neg, sum_neg_distrib] at *
      rw [hy, neg_zero]
  have hmem : (2 : ℤ) • ev u₀ ∈ D k := by
    change Even (∑ i, ((2 : ℤ) • ev u₀) i)
    simp [Pi.smul_apply, ← mul_sum, sum_ev]
  rw [← h] at hmem
  have h0 := hker _ hmem
  have : f ((2 : ℤ) • ev u₀) = 2 * ε u₀ := by
    simp only [f, Pi.smul_apply, smul_eq_mul, mul_left_comm _ (2 : ℤ), ← mul_sum]
    rw [show (∑ v, ε v * ev u₀ v) = f (ev u₀) from rfl, hf_ev]
  rw [this] at h0
  rcases (hε u₀).sign with h1 | h1 <;> rw [h1] at h0 <;> norm_num at h0

/-- **Type D.** The roots of a set of signed edges generate `D_k` iff every two coordinates are
joined by a walk and some closed walk has sign product `-1`. -/
theorem span_eq_D_iff (hk : 0 < k) (S : Set (SEdge k)) :
    L S = D k ↔ (∀ u w, ∃ t, Walk S u w t) ∧ ∃ u, Walk S u u (-1) :=
  ⟨fun h => ⟨conn_of_eq h, unbal_of_eq hk h⟩,
   fun ⟨hc, hu⟩ => le_antisymm L_le_D (D_le_L hc hu)⟩

end typeD

/-! ## Type A -/

section typeA

variable {S : Set (SEdge k)}

lemma Walk.sign_one (hS : ∀ e ∈ S, e.s = 1) {u w : Fin k} {t : ℤ} (p : Walk S u w t) : t = 1 := by
  induction p with
  | nil => rfl
  | fwd e he _ _ ih | bwd e he _ _ ih => rw [ih, hS e he, one_mul]

lemma L_le_A (hS : ∀ e ∈ S, e.s = 1) : L S ≤ A k := by
  refine (AddSubgroup.closure_le _).2 ?_
  rintro _ ⟨e, he, rfl⟩
  change ∑ i, (ev e.a - e.s • ev e.b) i = 0
  simp [hS e he, sum_sub_distrib, sum_ev]

/-- **Type A.** If every edge has sign `+1` (roots `e_a - e_b`), the roots generate
`A = {x | ∑ x = 0}` iff every two coordinates are joined by a walk. -/
theorem span_eq_A_iff (hk : 0 < k) (S : Set (SEdge k)) (hS : ∀ e ∈ S, e.s = 1) :
    L S = A k ↔ ∀ u w, ∃ t, Walk S u w t := by
  classical
  constructor
  · intro h
    by_contra hcon
    push Not at hcon
    obtain ⟨u, w, hw⟩ := hcon
    set V : Finset (Fin k) := univ.filter (fun v => ∃ t, Walk S u v t) with hV
    let φ : (Fin k → ℤ) → ℤ := fun x => ∑ i ∈ V, x i
    have hφ_ev : ∀ i, φ (ev i) = if i ∈ V then 1 else 0 := by
      intro i
      simp only [φ, ev, Finset.sum_pi_single']
    have hinv : ∀ y ∈ L S, φ y = 0 := by
      intro y hy
      induction hy using AddSubgroup.closure_induction with
      | mem y hy =>
        obtain ⟨e, he, rfl⟩ := hy
        have hab : e.a ∈ V ↔ e.b ∈ V := by
          simp only [hV, mem_filter, mem_univ, true_and]
          constructor
          · rintro ⟨t, p⟩; exact ⟨_, Walk.fwd e he p rfl⟩
          · rintro ⟨t, p⟩; exact ⟨_, Walk.bwd e he p rfl⟩
        have : φ (vec e) = φ (ev e.a) - e.s * φ (ev e.b) := by
          simp only [φ, vec, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, sum_sub_distrib, ← mul_sum]
        rw [this, hφ_ev, hφ_ev, hS e he]
        by_cases ha : e.a ∈ V
        · rw [if_pos ha, if_pos (hab.1 ha)]; simp
        · rw [if_neg ha, if_neg (fun hb => ha (hab.2 hb))]; simp
      | zero => simp [φ]
      | add y z _ _ hy hz =>
        simp only [φ, Pi.add_apply, sum_add_distrib] at *
        rw [hy, hz, add_zero]
      | neg y _ hy =>
        simp only [φ, Pi.neg_apply, sum_neg_distrib] at *
        rw [hy, neg_zero]
    have huV : u ∈ V := by
      simp only [hV, mem_filter, mem_univ, true_and]; exact ⟨1, Walk.nil u⟩
    have hwV : w ∉ V := by
      simp only [hV, mem_filter, mem_univ, true_and, not_exists]; exact hw
    have hmem : ev u - ev w ∈ A k := by
      change ∑ i, (ev u - ev w) i = 0
      simp [sum_sub_distrib, sum_ev]
    rw [← h] at hmem
    have := hinv _ hmem
    simp only [φ, Pi.sub_apply, sum_sub_distrib] at this
    have h1 : φ (ev u) = 1 := by rw [hφ_ev, if_pos huV]
    have h0 : φ (ev w) = 0 := by rw [hφ_ev, if_neg hwV]
    simp only [φ] at h1 h0
    rw [h1, h0] at this
    simp at this
  · intro hconn
    refine le_antisymm (L_le_A hS) ?_
    let u : Fin k := ⟨0, hk⟩
    have hdiff : ∀ i, ev i - ev u ∈ L S := by
      intro i
      obtain ⟨t, p⟩ := hconn u i
      have hp := p.mem_L
      rw [p.sign_one hS, one_smul] at hp
      have := neg_mem hp
      convert this using 1
      simp
    intro x hx
    have hx' : ∑ i, x i = 0 := hx
    have hdecomp : x = ∑ i, x i • (ev i - ev u) := by
      simp only [smul_sub, sum_sub_distrib, sum_smul_ev, ← sum_smul, hx', zero_smul, sub_zero]
    rw [hdecomp]
    exact sum_mem fun i _ => zsmul_mem (hdiff i) _

end typeA

end A114601
